# Placeholder template only. Keep real credentials in an ignored .env file or secret store.
# For the current worker, export these values in the environment before running engine/.
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_CLIENT_ID=replace-with-shopify-client-id
SHOPIFY_CLIENT_SECRET=replace-with-shopify-client-secret
GEMINI_API_KEY=replace-with-gemini-api-key

# Optional provider fallbacks
GROQ_API_KEY=
CLOUDFLARE_API_TOKEN=
